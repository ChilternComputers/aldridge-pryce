---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ConsultationCTA from '@/components/sections/ConsultationCTA.astro';
import { team } from '@/data/team';
import { getWebPageSchema } from '@/lib/schemas';
---

<Layout
  title="Our Team | Aldridge & Pryce Solicitors"
  description="Meet the team at Aldridge & Pryce. Our solicitors and support staff combine decades of legal expertise with a personal, approachable service."
  schema={getWebPageSchema({
    title: 'Our Team',
    description: 'Meet the experienced solicitors at Aldridge & Pryce.',
    url: '/team/',
  })}
>
  <PageHero
    title="Our People"
    subtitle="Experienced solicitors and dedicated professionals, each committed to delivering the highest standard of legal service."
    eyebrow="The Team"
  />

  <section style="background: var(--color-ivory); padding: 64px 32px 0;">
    <div style="max-width: 960px; margin: 0 auto;">
      <!-- Filter -->
      <div style="display: flex; gap: 8px; margin-bottom: 48px; flex-wrap: wrap;" data-reveal>
        {['All', 'Partners', 'Associates', 'Support'].map((label) => (
          <button
            class="team-filter font-body"
            data-filter={label.toLowerCase() === 'all' ? 'all' : label.toLowerCase()}
            style={`padding: 6px 18px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; border: 1px solid var(--color-border); background: transparent; color: #555;`}
          >
            {label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Team members — editorial list -->
  <section style="background: var(--color-ivory); padding: 0 32px 80px;">
    <div style="max-width: 960px; margin: 0 auto; border-top: 1px solid var(--color-border);">
      {team.map((member) => (
        <div
          class="team-member"
          data-department={member.department}
          style="display: grid; grid-template-columns: 1fr; gap: 24px; padding: 40px 0; border-bottom: 1px solid var(--color-border);"
          data-reveal
        >
          <!-- Portrait -->
          <div style="width: 120px; height: 150px; overflow: hidden; flex-shrink: 0;">
            <img
              src={member.image}
              alt={`${member.name}, ${member.role}`}
              loading="lazy"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover; object-position: top; filter: grayscale(15%);"
            />
          </div>

          <!-- Info -->
          <div>
            <h2 class="font-heading" style="font-size: 1.2rem; color: var(--color-navy); margin: 0 0 4px;">
              {member.name}
            </h3>
            <p class="font-body" style="font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #7A6339; margin: 0 0 4px;">
              {member.role} &mdash; {member.specialism}
            </p>
            <p class="font-body" style="font-size: 0.92rem; color: var(--color-charcoal); line-height: 1.7; margin: 12px 0 0; max-width: 560px;">
              {member.bio}
            </p>
            <div style="margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px;">
              {member.qualifications.map((q) => (
                <span class="font-body" style="font-size: 0.72rem; color: var(--color-muted); padding: 3px 10px; border: 1px solid var(--color-border);">
                  {q}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <ConsultationCTA />
</Layout>

<style>
  @media (min-width: 640px) {
    .team-member {
      grid-template-columns: 120px 1fr !important;
    }
  }
</style>

<script>
  const filters = document.querySelectorAll('.team-filter');
  const members = document.querySelectorAll('.team-member');

  // Set initial active
  filters[0]?.setAttribute('style', filters[0].getAttribute('style')?.replace('background: transparent; color: #555', 'background: var(--color-navy); color: var(--color-white); border-color: var(--color-navy)') || '');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      filters.forEach((f) => {
        const el = f as HTMLElement;
        el.style.background = 'transparent';
        el.style.color = '#555';
        el.style.borderColor = 'var(--color-border)';
      });

      const el = btn as HTMLElement;
      el.style.background = 'var(--color-navy)';
      el.style.color = 'var(--color-white)';
      el.style.borderColor = 'var(--color-navy)';

      members.forEach((member) => {
        const dept = (member as HTMLElement).dataset.department;
        (member as HTMLElement).style.display = (filter === 'all' || dept === filter) ? '' : 'none';
      });
    });
  });
</script>
