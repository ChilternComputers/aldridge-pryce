---
import { team } from '@/data/team';
import { ArrowRight } from '@lucide/astro';

const partners = team.filter(m => m.department === 'partners').slice(0, 4);
---

<section style="background: var(--color-white); padding: 96px 32px;" aria-label="Our team">
  <div style="max-width: 1100px; margin: 0 auto;">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 48px; flex-wrap: wrap; gap: 16px;" data-reveal>
      <div>
        <span class="eyebrow" style="display: block; margin-bottom: 14px;">Our Team</span>
        <h2 class="font-heading" style="margin: 0;">Led by experience</h2>
      </div>
      <a href="/team/" class="font-body" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-navy);">
        Full Team <ArrowRight size={14} aria-hidden="true" style="color: var(--color-brass);" />
      </a>
    </div>

    <!-- Partner grid — clean, no card borders -->
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: var(--color-border);" class="team-grid" data-stagger-parent>
      {partners.map((member) => (
        <div style="background: var(--color-white); padding: 0;" data-stagger-child>
          <!-- Portrait -->
          <div style="position: relative; height: 320px; overflow: hidden;">
            <img
              src={member.image}
              alt={`${member.name}, ${member.role}`}
              loading="lazy"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover; object-position: top; filter: grayscale(20%); transition: filter 0.4s ease;"
              class="team-portrait"
            />
          </div>
          <!-- Info -->
          <div style="padding: 20px 24px 28px;">
            <h3 class="font-heading" style="font-size: 1.05rem; color: var(--color-navy); margin: 0 0 4px;">{member.name}</h3>
            <p class="font-body" style="font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brass); margin: 0 0 8px;">{member.role}</p>
            <p class="font-body" style="font-size: 0.85rem; color: var(--color-muted); margin: 0;">{member.specialism}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(4, 1fr) !important;
    }
  }

  .team-portrait:hover {
    filter: grayscale(0%) !important;
  }
</style>
