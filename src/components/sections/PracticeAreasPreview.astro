---
import { practiceAreas } from '@/data/practice-areas';
import { ArrowRight } from '@lucide/astro';
---

<section style="background: var(--color-white); padding: 96px 32px;" aria-label="Our practice areas">
  <div style="max-width: 960px; margin: 0 auto;">
    <!-- Header -->
    <div style="margin-bottom: 56px;" data-reveal>
      <span class="eyebrow" style="display: block; margin-bottom: 14px;">Our Expertise</span>
      <h2 class="font-heading" style="margin: 0 0 14px;">Areas of Practice</h2>
      <div class="brass-rule"></div>
    </div>

    <!-- Practice area list — editorial, not cards -->
    <div style="border-top: 1px solid var(--color-border);" data-stagger-parent>
      {practiceAreas.map((area, i) => (
        <a
          href="/practice-areas/"
          class="practice-item"
          style="display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--color-border); text-decoration: none; transition: background-color 0.2s;"
          data-stagger-child
        >
          <span class="font-body" style="font-size: 0.75rem; color: var(--color-brass); font-weight: 600; letter-spacing: 0.05em;">
            0{i + 1}
          </span>
          <div>
            <span class="font-heading practice-title" style="font-size: 1.15rem; color: var(--color-navy); transition: color 0.2s;">
              {area.name}
            </span>
            <span class="font-body practice-desc" style="display: none; font-size: 0.88rem; color: var(--color-muted); margin-left: 16px;">
              {area.description.split('.')[0]}.
            </span>
          </div>
          <ArrowRight size={16} aria-hidden="true" class="practice-arrow" style="color: var(--color-brass); opacity: 0; transform: translateX(-8px); transition: opacity 0.25s, transform 0.25s;" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .practice-item:hover {
    background-color: rgba(249, 248, 245, 0.6);
    padding-left: 12px;
    padding-right: 12px;
  }

  .practice-item:hover .practice-arrow {
    opacity: 1 !important;
    transform: translateX(0) !important;
  }

  .practice-item:hover .practice-title {
    color: var(--color-brass) !important;
  }

  @media (min-width: 768px) {
    .practice-desc {
      display: inline !important;
    }
  }
</style>
