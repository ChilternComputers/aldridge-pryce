---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div style="display: flex; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-white);">
  <div style="width: 6px; height: 6px; background: var(--color-brass); border-radius: 50%;"></div>
  <span class="font-body" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-navy);">
    {name}
  </span>
</div>
