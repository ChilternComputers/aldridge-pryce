---
interface Props {
  videoId: string;
  title: string;
  thumbnail?: string;
}

const { videoId, title, thumbnail } = Astro.props;
const thumbUrl = thumbnail || `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
---

<div class="video-embed" style="position: relative; width: 100%; padding-bottom: 56.25%; background: var(--color-navy); overflow: hidden;">
  <img
    src={thumbUrl}
    alt={`Video thumbnail: ${title}`}
    loading="lazy"
    style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.7; transition: opacity 0.3s ease;"
  />
  <!-- Dark overlay -->
  <div style="position: absolute; inset: 0; background: rgba(15, 27, 45, 0.35);" aria-hidden="true"></div>
  <!-- Play button -->
  <button
    class="video-play-btn"
    aria-label={`Play video: ${title}`}
    data-video-id={videoId}
    data-video-title={title}
    style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 72px; height: 72px; border-radius: 50%; background: var(--color-brass); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform 0.2s ease, box-shadow 0.2s ease; box-shadow: 0 4px 24px rgba(0,0,0,0.3); z-index: 2;"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true" style="margin-left: 3px;">
      <polygon points="6,3 20,12 6,21" />
    </svg>
  </button>
</div>

<style>
  .video-embed:hover img {
    opacity: 0.85 !important;
  }
  .video-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.08) !important;
    box-shadow: 0 6px 32px rgba(0,0,0,0.4) !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-play-btn {
      transition: none !important;
    }
    .video-embed img {
      transition: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll('.video-play-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const videoId = btn.getAttribute('data-video-id');
      const title = btn.getAttribute('data-video-title');
      const container = btn.closest('.video-embed') as HTMLElement;
      if (!container || !videoId) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position: absolute; inset: 0; width: 100%; height: 100%; border: none;';
      container.innerHTML = '';
      container.appendChild(iframe);
    });
  });
</script>
