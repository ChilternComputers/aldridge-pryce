---
interface Props {
  name: string;
  role: string;
  specialism: string;
  bio: string;
  image: string;
  department: string;
}

const { name, role, specialism, bio, image, department } = Astro.props;
---

<div
  class="card-hover team-card"
  data-department={department}
  style="background: var(--color-white); border-radius: 2px; overflow: hidden; border: 1px solid var(--color-border);"
>
  <div style="position: relative; height: 280px; overflow: hidden;">
    <img
      src={image}
      alt={`${name}, ${role}`}
      loading="lazy"
      decoding="async"
      style="width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.6s ease;"
    />
    <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,27,45,0.6) 0%, transparent 50%);"></div>
  </div>
  <div style="padding: 20px;">
    <h3 class="font-heading" style="font-size: 1.05rem; color: var(--color-navy); margin: 0 0 4px;">
      {name}
    </h3>
    <p class="font-body" style="font-size: 0.8rem; font-weight: 600; color: var(--color-brass); margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.08em;">
      {role}
    </p>
    <p class="font-body" style="font-size: 0.85rem; color: var(--color-muted); margin: 0 0 12px;">
      {specialism}
    </p>
    <p class="font-body team-bio" style="font-size: 0.85rem; color: var(--color-charcoal); line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; transition: all 0.3s ease;">
      {bio}
    </p>
  </div>
</div>

<style>
  .team-card:hover .team-bio {
    -webkit-line-clamp: unset;
  }
  .team-card:hover img {
    transform: scale(1.05);
  }
</style>
