---
import { ArrowRight } from '@lucide/astro';

interface Props {
  name: string;
  description: string;
  image: string;
  href: string;
}

const { name, description, image, href } = Astro.props;
---

<a href={href} class="card-hover img-zoom" style="display: block; background: var(--color-white); border-radius: 2px; overflow: hidden; text-decoration: none; border: 1px solid var(--color-border);">
  <div style="position: relative; height: 200px; overflow: hidden;">
    <img
      src={image}
      alt=""
      role="presentation"
      loading="lazy"
      decoding="async"
      style="width: 100%; height: 100%; object-fit: cover;"
    />
    <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,27,45,0.5) 0%, transparent 60%);"></div>
  </div>
  <div style="padding: 24px;">
    <h3 class="font-heading brass-underline" style="font-size: 1.15rem; color: var(--color-navy); margin: 0 0 12px;">
      {name}
    </h3>
    <p class="font-body" style="font-size: 0.9rem; color: var(--color-muted); line-height: 1.65; margin: 0 0 16px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
      {description}
    </p>
    <span class="font-body" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 600; color: var(--color-brass); text-transform: uppercase; letter-spacing: 0.08em;">
      Learn more <ArrowRight size={14} aria-hidden="true" />
    </span>
  </div>
</a>
