---
import type { FeeCategory } from '@/data/fees';

interface Props {
  fee: FeeCategory;
}

const { fee } = Astro.props;
---

<div style="background: var(--color-white); border: 1px solid var(--color-border); border-radius: 2px; overflow: hidden;">
  <!-- Header -->
  <div style="background: var(--color-navy); padding: 24px 32px;">
    <h3 class="font-heading" style="font-size: 1.3rem; color: #FFFFFF; margin: 0 0 8px;">
      {fee.service}
    </h3>
    <span class="font-body" style="font-size: 1.1rem; font-weight: 600; color: var(--color-brass);">
      {fee.feeRange}
    </span>
  </div>

  <div style="padding: 32px;">
    <p class="font-body" style="font-size: 0.95rem; color: var(--color-charcoal); line-height: 1.7; margin: 0 0 28px;">
      {fee.description}
    </p>

    <!-- Stages -->
    <div style="margin-bottom: 28px;">
      <h4 class="font-body" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-brass); margin: 0 0 14px;">
        Key Stages
      </h4>
      <ol style="padding-left: 20px; margin: 0; display: flex; flex-direction: column; gap: 8px;">
        {fee.stages.map((stage) => (
          <li class="font-body" style="font-size: 0.9rem; color: var(--color-charcoal); line-height: 1.5;">
            {stage}
          </li>
        ))}
      </ol>
    </div>

    <!-- Disbursements -->
    <div style="margin-bottom: 28px;">
      <h4 class="font-body" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-brass); margin: 0 0 14px;">
        Disbursements (costs payable to third parties)
      </h4>
      <ul style="padding-left: 20px; margin: 0; display: flex; flex-direction: column; gap: 8px;">
        {fee.disbursements.map((item) => (
          <li class="font-body" style="font-size: 0.9rem; color: var(--color-charcoal); line-height: 1.5;">
            {item}
          </li>
        ))}
      </ul>
    </div>

    <!-- Timescale -->
    <div style="margin-bottom: 28px;">
      <h4 class="font-body" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-brass); margin: 0 0 14px;">
        Timescale
      </h4>
      <p class="font-body" style="font-size: 0.9rem; color: var(--color-charcoal); line-height: 1.7; margin: 0;">
        {fee.timescale}
      </p>
    </div>

    <!-- Handler -->
    <div style="padding: 16px 20px; background: var(--color-stone); border-radius: 2px;">
      <h4 class="font-body" style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-brass); margin: 0 0 8px;">
        Who will handle my matter?
      </h4>
      <p class="font-body" style="font-size: 0.88rem; color: var(--color-charcoal); line-height: 1.6; margin: 0;">
        {fee.handler}
      </p>
    </div>

    <!-- VAT note -->
    <p class="font-body" style="font-size: 0.8rem; color: var(--color-muted); margin: 20px 0 0; font-style: italic;">
      All fees are subject to VAT at the prevailing rate (currently 20%). A detailed, personalised quote will be provided before we begin work on your matter.
    </p>
  </div>
</div>
