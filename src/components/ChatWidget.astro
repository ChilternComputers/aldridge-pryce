---
---

<!-- WhatsApp / Enquiry chat widget -->
<div id="chat-widget" style="position: fixed; bottom: 24px; right: 24px; z-index: 90;">
  <!-- Panel -->
  <div
    id="chat-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Contact options"
    style="position: absolute; bottom: 64px; right: 0; width: 280px; background: var(--color-white); border: 1px solid var(--color-border); box-shadow: 0 8px 32px rgba(0,0,0,0.12); opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity 0.25s ease, transform 0.25s ease;"
  >
    <div style="padding: 24px;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
        <h3 class="font-heading" style="font-size: 1rem; margin: 0; color: var(--color-navy);">Need legal advice?</h3>
        <button
          id="chat-close"
          aria-label="Close contact panel"
          style="background: none; border: none; cursor: pointer; color: var(--color-muted); padding: 4px; line-height: 1;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <p class="font-body" style="font-size: 0.85rem; color: var(--color-muted); line-height: 1.6; margin: 0 0 20px;">
        Chat with us on WhatsApp or send an enquiry.
      </p>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <a
          href="https://wa.me/441614837200?text=Hello%2C%20I%27d%20like%20to%20discuss%20a%20legal%20matter."
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; background: #25D366; color: #FFFFFF; font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; transition: background-color 0.2s;"
          class="chat-whatsapp-btn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </a>
        <a
          href="/contact/"
          style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; background: var(--color-navy); color: var(--color-white); font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; transition: background-color 0.2s;"
          class="chat-enquiry-btn"
        >
          Send Enquiry
        </a>
      </div>
    </div>
  </div>

  <!-- Toggle button -->
  <button
    id="chat-toggle"
    aria-label="Open contact options"
    aria-expanded="false"
    style="width: 48px; height: 48px; border-radius: 50%; background: #25D366; color: #FFFFFF; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(0,0,0,0.15); transition: transform 0.2s ease, box-shadow 0.2s ease;"
  >
    <svg id="chat-icon-msg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <svg id="chat-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<style>
  .chat-whatsapp-btn:hover {
    background-color: #1da851 !important;
  }
  .chat-enquiry-btn:hover {
    background-color: #162640 !important;
  }
  #chat-toggle:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    #chat-panel {
      transition: none !important;
    }
    #chat-toggle {
      transition: none !important;
    }
  }
</style>

<script>
  const widget = document.getElementById('chat-widget');
  const toggle = document.getElementById('chat-toggle');
  const panel = document.getElementById('chat-panel');
  const closeBtn = document.getElementById('chat-close');
  const iconMsg = document.getElementById('chat-icon-msg');
  const iconClose = document.getElementById('chat-icon-close');

  // Hide on contact page
  if (window.location.pathname.startsWith('/contact')) {
    widget?.setAttribute('style', widget.getAttribute('style') + '; display: none;');
  }

  let isOpen = false;

  function openPanel() {
    isOpen = true;
    if (panel) {
      panel.style.opacity = '1';
      panel.style.transform = 'translateY(0)';
      panel.style.pointerEvents = 'auto';
    }
    if (toggle) toggle.setAttribute('aria-expanded', 'true');
    if (iconMsg) iconMsg.style.display = 'none';
    if (iconClose) iconClose.style.display = 'block';
  }

  function closePanel() {
    isOpen = false;
    if (panel) {
      panel.style.opacity = '0';
      panel.style.transform = 'translateY(12px)';
      panel.style.pointerEvents = 'none';
    }
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
    if (iconMsg) iconMsg.style.display = 'block';
    if (iconClose) iconClose.style.display = 'none';
  }

  toggle?.addEventListener('click', () => {
    isOpen ? closePanel() : openPanel();
  });

  closeBtn?.addEventListener('click', closePanel);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closePanel();
  });

  document.addEventListener('click', (e) => {
    if (isOpen && widget && !widget.contains(e.target as Node)) {
      closePanel();
    }
  });
</script>
